{
  "name": "react-typescript",
  "version": "1.1.1",
  "description": "React and TypeScript example starter project",
  "keywords": ["typescript", "react", "starter"],
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:release": "npm run build && electron-builder --publish never && node publish-release.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.106.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.1",
    "electron-updater": "^6.8.9",
    "qrcode.react": "4.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "18.2.38",
    "@types/react-dom": "18.2.15",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "4.4.4",
    "vite": "^5.0.11",
    "wait-on": "^9.0.10"
  },
    "overrides": {
    "@noble/hashes": "^1.4.0"
  },
  "browserslist": [">0.2%", "not dead", "not ie <= 11", "not op_mini all"],
  "build": {
    "appId": "com.ahmed.pharmacypro",
    "productName": "PharmacyPro",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "win": { "target": "nsis" },
    "publish": {
      "provider": "github",
      "owner": "abdelghani-bot",
      "repo": "suspicious-dream-forked-"
    }
  }
}